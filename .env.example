# ─── general ────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=info
LOG_TRANSCRIPTS=false
API_KEY=change-me

# ─── storage (local disk — no MinIO). Native dev: host paths. 
DATA_DIR=C:/data
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=workbench
POSTGRES_USER=workbench
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://localhost:6379/0

# ─── ingest limits ──────────────────────────────────────────
MAX_UPLOAD_MB=50
MAX_DURATION_S=90
TARGET_DURATION_S=60
MIN_DURATION_S=0.5

# ─── compute ────────────────────────────────────────────────
DEVICE=auto
# GPU compute type; pool.py falls back to int8 automatically on CPU
PRECISION=float16
WORKER_CONCURRENCY=2
JOB_TIMEOUT_S=300
JOB_MAX_ATTEMPTS=3

# ─── models ─────────────────────────────────────────────────
MODEL_DIR=C:/models
ASR_MODEL=large-v3-turbo
ASR_BEAM_SIZE=5
ASR_LANGUAGE=auto
VAD_MODEL=silero-vad
DIAR_MODEL=pyannote-3.1
EMBED_MODEL=ecapa
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ─── pre-processing ─────────────────────────────────────────
HIGHPASS_HZ=70
TARGET_LUFS=-23.0
DENOISE_ENABLED=true
DENOISE_PROP_DECREASE=0.75
CLIPPING_THRESHOLD=0.99
VAD_MIN_SPEECH_MS=200
VAD_MIN_SILENCE_MS=150
VAD_SPEECH_PAD_MS=100
MIN_TOTAL_SPEECH_S=0.5

# ─── quality grading ────────────────────────────────────────
QUALITY_GOOD_SNR_DB=18
QUALITY_FAIR_SNR_DB=10
QUALITY_MAX_CLIPPING=0.02
QUALITY_MIN_BANDWIDTH_HZ=3400

# ─── diarization ────────────────────────────────────────────
DIAR_MIN_SPEAKERS=1
DIAR_MAX_SPEAKERS=4
MIN_TURN_S=0.4
MERGE_GAP_S=0.6
VAD_SNAP_TOL_S=0.15
OVERLAP_WARN_RATIO=0.30

# ─── reconciliation ─────────────────────────────────────────
SMOOTH_MIN_CONF=0.60

# ─── embeddings & identification ────────────────────────────
EMBED_MIN_S=1.5
EMBED_TARGET_S=8.0
RELIABILITY_GOOD=0.75
RELIABILITY_FAIR=0.45
RELIABILITY_POOR=0.20

ID_THRESHOLD=0.55
ID_SUGGEST_DELTA=0.08
ID_MIN_MARGIN=0.04
ID_THRESHOLD_PENALTY=0.10
VERIFY_THRESHOLD=0.62
CLUSTER_THRESHOLD=0.52
AUTO_ENROLL=false
AUTO_ENROLL_MIN_SIM=0.85
AUTO_ENROLL_MIN_RELIABILITY=0.75

# ─── retention ──────────────────────────────────────────────
RETENTION_DAYS=0
